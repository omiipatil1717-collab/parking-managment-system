# ====================================================================
# SMARTPARK CAMPUS - ENVIRONMENT CONFIGURATION
# ====================================================================

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Connection (Leave blank or fill with your Supabase credentials)
# When left blank, SmartPark operates with 100% full fidelity local state & mock sync
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Campus Timezone
NEXT_PUBLIC_CAMPUS_TIMEZONE=Asia/Kolkata
